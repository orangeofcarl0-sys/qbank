<!doctype html>
<html lang="{{ question.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="qrc:///qtwebchannel/qwebchannel.js"></script>
  <script>
    window.MathJax = {
      tex: {inlineMath: [['$', '$'], ['\\(', '\\)']]},
      svg: {fontCache: 'global'}
    };
  </script>
  <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
  <style>
    {{ theme_css | safe }}
    :root { color-scheme: {{ theme }}; font: 15px/1.65 var(--qbank-document-font); }
    body { margin: 0; padding: 28px 34px 80px; color: var(--qbank-text-primary); background: var(--qbank-surface-elevated); }
    h1 { margin: 0 0 4px; font-size: 22px; }
    .meta { color: var(--qbank-text-secondary); margin-bottom: 24px; }
    section { margin: 24px 0; }
    section > h2 { color: var(--qbank-text-secondary); font-size: 13px; letter-spacing: .08em; }
    img[data-asset-id] {
      max-width: 100%; min-width: 48px; border: 2px solid transparent;
      border-radius: 5px; cursor: context-menu;
    }
    img[data-asset-id]:hover, img.asset-target { border-color: var(--qbank-focus); }
    img[data-asset-id]:focus { border-color: var(--qbank-focus); outline: none; }
    .asset-object { position: relative; display: inline-block; max-width: 100%; }
    .asset-tip { position: absolute; right: 8px; bottom: 8px; padding: 2px 7px;
      border-radius: var(--qbank-radius-small); color: var(--qbank-text-primary);
      background: color-mix(in srgb, var(--qbank-surface-elevated) 92%, transparent);
      border: 1px solid var(--qbank-border-subtle); font-size: 12px; opacity: 0;
      pointer-events: none; transition: opacity 80ms linear; }
    .asset-object:hover .asset-tip, .asset-object:focus-within .asset-tip { opacity: 1; }
    .asset-state { margin-top: 32px; border-top: 1px solid var(--qbank-border-subtle); padding-top: 10px; }
    .asset-state span { display: inline-block; margin: 4px; padding: 2px 7px;
      border-radius: 10px; background: var(--qbank-surface-hover); font-size: 12px; }
    .asset-state .stale { color: var(--qbank-warning); background: color-mix(in srgb, var(--qbank-warning) 13%, transparent); }
    .drop-hint { box-sizing: border-box; display: flex; align-items: center;
      justify-content: center; gap: 4px 10px; flex-wrap: wrap; width: 100%;
      margin-top: 20px; padding: 9px 12px; color: var(--qbank-text-secondary);
      background: var(--qbank-surface); border-top: 1px solid var(--qbank-border-subtle);
      font-size: 12px; line-height: 1.45; text-align: center; }
    .drop-hint strong { color: var(--qbank-text-primary); font-weight: 600; white-space: nowrap; }
    .drop-hint span { min-width: 0; }
    @media (max-width: 520px) {
      body { padding-right: 20px; padding-left: 20px; }
      .drop-hint { align-items: flex-start; justify-content: flex-start; text-align: left; }
      .drop-hint span { flex-basis: 100%; }
    }
  </style>
</head>
<body data-question-id="{{ question.id }}">
  <h1>{{ question.title }}</h1>
  <div class="meta"><code>{{ question.id }}</code> · {{ question.subject }} · {{ question.status }}</div>
  {% for section in sections %}
  {% if section.html %}
  <section data-field="{{ section.field }}">
    <h2>{{ section.title }}</h2>
    <div class="content">{{ section.html | safe }}</div>
  </section>
  {% endif %}
  {% endfor %}
  <div class="asset-state">
    {% for asset in assets %}
    <span class="{% if asset.status != 'final' or asset.representations | selectattr('stale') | list %}stale{% endif %}">
      {{ asset.asset_id }} · {{ asset.status }}
      {% if asset.representations | selectattr('stale') | list %}· stale{% endif %}
    </span>
    {% endfor %}
  </div>
  <div class="drop-hint" role="note">
    <strong>拖入图片</strong><span>落在题图上替换 · 落在空白处新建资产</span>
  </div>
  <script>
    let bridge = null;
    window.qbankAssetActionsEnabled = false;
    new QWebChannel(qt.webChannelTransport, channel => { bridge = channel.objects.previewBridge; });

    function assetImage(node) {
      if (!node || !node.closest) return null;
      return node.closest('img[data-asset-id]')
        || node.closest('.asset-object')?.querySelector('img[data-asset-id]')
        || null;
    }
    document.querySelectorAll('img[data-asset-id]').forEach(image => {
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-label', `${image.alt || '图片'}；Enter 编辑，Shift+F10 打开操作菜单`);
      const wrapper = document.createElement('span');
      wrapper.className = 'asset-object';
      image.before(wrapper);
      wrapper.append(image);
      const tip = document.createElement('span');
      tip.className = 'asset-tip';
      tip.textContent = '右键或 Shift+F10 操作';
      wrapper.append(tip);
    });
    document.addEventListener('contextmenu', event => {
      const image = assetImage(event.target);
      if (!image || !window.qbankAssetActionsEnabled) return;
      event.preventDefault();
      if (bridge) bridge.requestContextMenu(image.dataset.assetId, event.clientX, event.clientY);
    });
    document.addEventListener('dblclick', event => {
      const image = assetImage(event.target);
      if (image && bridge && window.qbankAssetActionsEnabled) bridge.requestAction(image.dataset.assetId, 'edit');
    });
    document.addEventListener('keydown', event => {
      const image = assetImage(event.target);
      if (!image || !bridge || !window.qbankAssetActionsEnabled) return;
      if (event.key === 'Enter') {
        event.preventDefault();
        bridge.requestAction(image.dataset.assetId, 'edit');
      } else if (event.key === 'ContextMenu' || (event.shiftKey && event.key === 'F10')) {
        event.preventDefault();
        const rect = image.getBoundingClientRect();
        bridge.requestContextMenu(
          image.dataset.assetId,
          Math.round(rect.left),
          Math.round(rect.bottom),
        );
      }
    });
    document.addEventListener('dragover', event => {
      event.preventDefault();
      const image = assetImage(event.target);
      document.querySelectorAll('.asset-target').forEach(node => node.classList.remove('asset-target'));
      if (image) image.classList.add('asset-target');
    });
    document.addEventListener('dragleave', event => {
      if (!event.relatedTarget) document.querySelectorAll('.asset-target')
        .forEach(node => node.classList.remove('asset-target'));
    });
    document.addEventListener('drop', event => {
      event.preventDefault();
      document.querySelectorAll('.asset-target').forEach(node => node.classList.remove('asset-target'));
      const file = event.dataTransfer.files[0];
      if (!file || !bridge || !window.qbankAssetActionsEnabled) return;
      const image = assetImage(event.target);
      const reader = new FileReader();
      reader.onload = () => bridge.assetDropped(image?.dataset.assetId || '', file.name, reader.result);
      reader.readAsDataURL(file);
    });
  </script>
</body>
</html>
