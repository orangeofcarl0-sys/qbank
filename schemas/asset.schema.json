{
  "$defs": {
    "AssetFormat": {
      "description": "Representations understood by the built-in adapters.",
      "enum": [
        "png",
        "jpeg",
        "pdf",
        "svg",
        "tikz",
        "ipe",
        "webp",
        "gif",
        "bmp",
        "url",
        "other"
      ],
      "title": "AssetFormat",
      "type": "string"
    },
    "AssetRepresentation": {
      "additionalProperties": false,
      "description": "One durable source, editable form, or rendered derivative.",
      "properties": {
        "representation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Representation Id",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/AssetFormat"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "editable": {
          "default": false,
          "title": "Editable",
          "type": "boolean"
        },
        "derived_from": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "representation_id",
        "format",
        "purpose"
      ],
      "title": "AssetRepresentation",
      "type": "object"
    },
    "AssetStatus": {
      "description": "Lifecycle states for one logical asset.",
      "enum": [
        "raw",
        "needs_redraw",
        "editing",
        "reviewed",
        "final",
        "failed"
      ],
      "title": "AssetStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Authoritative ``asset.yaml`` for one logical question asset.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "asset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Asset Id",
      "type": "string"
    },
    "question_id": {
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$",
      "title": "Question Id",
      "type": "string"
    },
    "role": {
      "minLength": 1,
      "title": "Role",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AssetStatus"
    },
    "preferred_editor": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Editor"
    },
    "preferred_render": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Render"
    },
    "representations": {
      "items": {
        "$ref": "#/$defs/AssetRepresentation"
      },
      "minItems": 1,
      "title": "Representations",
      "type": "array"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "review_notes": {
      "default": "",
      "title": "Review Notes",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "question_id",
    "role",
    "status",
    "representations"
  ],
  "title": "AssetManifest",
  "type": "object"
}
